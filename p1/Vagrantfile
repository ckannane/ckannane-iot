# -*- mode: ruby -*-
# vi: set ft=ruby :

require "securerandom"

# Official Rocky Linux box, published by the Rocky project itself (not the
# HashiCorp registry). "latest" always points to the newest point release.
BOX     = "rockylinux-10"
BOX_URL = "https://dl.rockylinux.org/pub/rocky/10/images/x86_64/Rocky-10-Vagrant-Vbox.latest.x86_64.vagrant.virtualbox.box"
LOGIN   = "ckannane"

NODES = {
  "#{LOGIN}S"  => { ip: "192.168.56.110", role: "server" },
  "#{LOGIN}SW" => { ip: "192.168.56.111", role: "agent"  },
}

SERVER_IP = NODES["#{LOGIN}S"][:ip]

# Pre-shared K3s join token, generated once on the host and handed to both
# nodes, so the agent never has to read anything back from the server.
TOKEN_FILE = File.join(__dir__, ".k3s-token")
File.write(TOKEN_FILE, SecureRandom.hex(32)) unless File.exist?(TOKEN_FILE)
K3S_TOKEN = File.read(TOKEN_FILE).strip

Vagrant.configure("2") do |config|
  config.vm.box     = BOX
  config.vm.box_url = BOX_URL
  config.vm.box_check_update = false

  # The official box ships without VirtualBox Guest Additions; nothing here
  # needs a shared folder, so skip it instead of failing on vboxsf.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # OpenSSH 9.8+ temporarily refuses sources that trip its penalty rules. Through
  # VirtualBox NAT every connection comes from 10.0.2.2, so exempt that address
  # or vagrant ssh can get locked out.
  config.vm.provision "shell", inline: <<-SHELL
    echo 'PerSourcePenaltyExemptList 10.0.2.2' > /etc/ssh/sshd_config.d/10-vagrant-nat.conf
    systemctl reload sshd
  SHELL

  NODES.each do |name, opts|
    config.vm.define name do |node|
      node.vm.hostname = name

      node.vm.network "private_network", ip: opts[:ip]

      node.vm.provider "virtualbox" do |vb|
        vb.name   = name
        vb.memory = 1024
        vb.cpus   = 1
      end

      if opts[:role] == "server"
        node.vm.provision "shell",
          path: "scripts/install_k3s_server.sh",
          env:  { "NODE_IP" => opts[:ip], "K3S_TOKEN" => K3S_TOKEN }
      else
        node.vm.provision "shell",
          path: "scripts/install_k3s_agent.sh",
          env:  { "NODE_IP" => opts[:ip], "SERVER_IP" => SERVER_IP, "K3S_TOKEN" => K3S_TOKEN }
      end
    end
  end
end

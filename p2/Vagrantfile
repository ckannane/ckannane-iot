# -*- mode: ruby -*-
# vi: set ft=ruby :

# Official Rocky Linux box, published by the Rocky project itself (not the
# HashiCorp registry). "latest" always points to the newest point release.
BOX     = "rockylinux-10"
BOX_URL = "https://dl.rockylinux.org/pub/rocky/10/images/x86_64/Rocky-10-Vagrant-Vbox.latest.x86_64.vagrant.virtualbox.box"
LOGIN   = "ckannane"
NAME    = "#{LOGIN}S"
IP      = "192.168.56.110"

Vagrant.configure("2") do |config|
  config.vm.box     = BOX
  config.vm.box_url = BOX_URL
  config.vm.box_check_update = false
  # K3s can take longer than Vagrant's default 60s to stop on this small VM.
  config.vm.graceful_halt_timeout = 180

  # The official box ships without VirtualBox Guest Additions, so the
  # manifests are uploaded over SSH instead of through a shared folder.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # OpenSSH 9.8+ temporarily refuses sources that trip its penalty rules. Through
  # VirtualBox NAT every connection comes from 10.0.2.2, so exempt that address
  # or vagrant ssh can get locked out.
  config.vm.provision "shell", inline: <<-SHELL
    echo 'PerSourcePenaltyExemptList 10.0.2.2' > /etc/ssh/sshd_config.d/10-vagrant-nat.conf
    systemctl reload sshd
  SHELL

  config.vm.define NAME do |node|
    node.vm.hostname = NAME
    node.vm.network "private_network", ip: IP

    node.vm.provider "virtualbox" do |vb|
      vb.name   = NAME
      # More than Part 1's minimum: on 1 GB, Traefik's Helm install kept restarting
      # with almost no memory left once the three apps were running.
      vb.memory = 2048
      vb.cpus   = 1
    end

    # Clear any previous upload first, or a re-provision would nest the
    # folder as /tmp/confs/confs.
    node.vm.provision "shell", inline: "rm -rf /tmp/confs"
    node.vm.provision "file", source: "confs", destination: "/tmp/confs"
    node.vm.provision "shell",
      path: "scripts/install_k3s.sh",
      env:  { "NODE_IP" => IP }
  end
end
